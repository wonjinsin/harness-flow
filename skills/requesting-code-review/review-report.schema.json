{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable review assignment report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "role",
    "fromSha",
    "toSha",
    "packetDigest",
    "reviewedFileIndices",
    "reviewedSections",
    "checksCompleted",
    "priorVerification",
    "complete",
    "incompleteReasons",
    "highRiskSignals",
    "findings",
    "strengths"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "detail_a",
        "detail_b",
        "integration",
        "single"
      ]
    },
    "fromSha": {
      "$ref": "#/$defs/commit"
    },
    "toSha": {
      "$ref": "#/$defs/commit"
    },
    "packetDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewedFileIndices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "reviewedSections": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "checksCompleted": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "requirements",
          "correctness",
          "edge-cases",
          "error-handling",
          "types",
          "prior-blockers",
          "security",
          "authorization",
          "data-loss",
          "concurrency",
          "integration",
          "compatibility",
          "architecture",
          "performance",
          "verification",
          "tests",
          "migration",
          "comments",
          "documentation",
          "maintainability"
        ]
      }
    },
    "priorVerification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding",
          "evidence"
        ],
        "properties": {
          "finding": {
            "$ref": "#/$defs/text"
          },
          "evidence": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "complete": {
      "type": "boolean"
    },
    "incompleteReasons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "highRiskSignals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "path",
        "line",
        "problem",
        "consequence",
        "correction"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "Critical",
            "Important",
            "Minor"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "problem": {
          "$ref": "#/$defs/text"
        },
        "consequence": {
          "$ref": "#/$defs/text"
        },
        "correction": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
